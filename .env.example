# ============================================================================
# Enterprise NMS Environment Template
# ============================================================================
APP_VERSION=1.0.0
BUILD_TAG=local
COMPOSE_PROJECT_NAME=nms-enterprise

# ASP.NET Core Runtime Configuration
ASPNETCORE_ENVIRONMENT=Development
API_HOST_PORT=5000

# Microsoft SQL Server Configuration
MSSQL_PORT=1433
MSSQL_SA_PASSWORD=ChangeThisToStrongPassword123!
DB_CONNECTION_STRING=Server=nms.database,1433;Database=NmsEnterpriseDb;User Id=sa;Password=ChangeThisToStrongPassword123!;TrustServerCertificate=True;Pooling=true;Min Pool Size=5;Max Pool Size=1024;Connect Timeout=30;

# Redis Distributed Cache Configuration
REDIS_PORT=6379
REDIS_CONNECTION_STRING=nms.cache:6379,abortConnect=false,connectTimeout=5000

# JWT Authentication Configuration
JWT_SECRET=ReplaceWithAtLeast32ByteCryptographicKeyForSigningTokens!
JWT_ISSUER=NmsEnterpriseApi
JWT_AUDIENCE=NmsEnterpriseClients

# OpenTelemetry Exporter Configuration
OTEL_SERVICE_NAME=NmsEnterprise.Api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_ENABLE_TRACING=true
OTEL_ENABLE_METRICS=true